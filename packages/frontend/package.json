{
  "name": "@flashlearn/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json && vite build",
    "build:demo": "tsc -p tsconfig.ui.json && vite build --mode demo",
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "preview:demo": "vite preview --mode demo",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.ui.json",
    "test": "tsx --test test/**/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@playwright/test": "^1.48.0",
    "vite": "^6.4.0"
  }
}
