{
  "name": "@flashlearn/frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p client/tsconfig.json --noEmit && vite build --config client/vite.config.ts",
    "dev": "vite --config client/vite.config.ts",
    "preview": "vite preview --config client/vite.config.ts",
    "shot": "node client/scripts/shot.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "demo": "tsc -p client/tsconfig.json --noEmit && vite build --config client/vite.config.ts --mode demo",
    "preview:demo": "vite preview --config client/vite.config.ts --mode demo",
    "test:browser": "playwright test",
    "test:browser:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "vite": "^6.4.3",
    "@playwright/test": "^1.58.0"
  }
}
